{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>UnstoppableMango/renovate-config",
    "schedule:weekly"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Update container image digests in nix2container pullImage calls",
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkgs/images/.+\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)(?:\\n\\s+#[^\\n]*)*\\n\\s+imageDigest = \"(?<currentDigest>sha256:[a-f0-9]+)\";"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
